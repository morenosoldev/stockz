# ==============================================================================
# Recover-Bot Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME=Recover-Bot
APP_VERSION=1.0.0
APP_DEBUG=false
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
STRUCTURED_LOGGING=true

# ------------------------------------------------------------------------------
# AI/LLM Configuration
# ------------------------------------------------------------------------------
# OpenAI API key for chatbot functionality
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Anthropic Claude API key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://recoverbot:recoverbot@localhost:5432/recoverbot

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ------------------------------------------------------------------------------
# Scheduler Configuration
# ------------------------------------------------------------------------------
# Cron schedule for daily scans (UTC time)
# Default: 16:30 UTC (after US market close)
CRON_SCHEDULE=30 16 * * *

# Scheduler timezone
SCHEDULER_TIMEZONE=UTC

# Enable/disable scheduler (true/false)
SCHEDULER_ENABLED=true

# ------------------------------------------------------------------------------
# Scanner Configuration
# ------------------------------------------------------------------------------
# Number of tickers to scan from universe
UNIVERSE_SIZE=2000

# Concurrent ticker processing
CONCURRENCY=50

# Scanner timeout in seconds
SCANNER_TIMEOUT=600
SCAN_TIMEOUT_SECONDS=600

# Cache TTL in seconds (1 hour)
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# Data Source API Keys
# ------------------------------------------------------------------------------
# Yahoo Finance (optional - yfinance uses public API)
YAHOO_FINANCE_API_KEY=

# Alpha Vantage (for alternative price data)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here
PRICE_API_KEY=your_api_key_here

# NewsAPI (for news sentiment)
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_api_key_here

# Data provider selection (yahoo_finance, alpha_vantage)
PRICE_DATA_PROVIDER=yahoo_finance

# ------------------------------------------------------------------------------
# Strategy Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of enabled strategies
ENABLED_STRATEGIES=drop5

# Default minimum score threshold for candidates
MIN_SCORE_THRESHOLD=0.5
SCORE_THRESHOLD=0.3

# ------------------------------------------------------------------------------
# Feature Engineering
# ------------------------------------------------------------------------------
# Feature version for reproducibility
FEATURE_VERSION=1.0.0

# Default lookback windows
ATR_WINDOW=14
RSI_WINDOW=14
SMA_WINDOW=50
VOLUME_WINDOW=20

# ------------------------------------------------------------------------------
# Evaluation & Backtesting
# ------------------------------------------------------------------------------
# Recovery window in trading days
RECOVERY_WINDOW_DAYS=5

# Recovery threshold (percentage)
RECOVERY_THRESHOLD_PCT=3.0

# Backfill date range (YYYY-MM-DD)
BACKFILL_START_DATE=2024-01-01
BACKFILL_END_DATE=2024-12-31

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Enable API docs (Swagger UI)
API_DOCS_ENABLED=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# Monitoring & Observability
# ------------------------------------------------------------------------------
# Enable Prometheus metrics
METRICS_ENABLED=false

# Metrics endpoint path
METRICS_PATH=/metrics
